{
  "name": "onchain-fishing-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-abi.mjs",
    "dev": "node scripts/sync-abi.mjs && vite --port 5180 --strictPort",
    "build": "node scripts/sync-abi.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "vitest run --config vitest.sim.config.ts"
  },
  "dependencies": {
    "@fluent.xyz/connect": "0.8.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.2",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.1.0"
  }
}
